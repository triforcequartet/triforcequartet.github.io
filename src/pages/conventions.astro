---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
const conventions = await getCollection('conventions');
const conventionsContent = await Promise.all(
  conventions.map(async (convention) => {
    const { Content } = await convention.render();
    return {
      ...convention,
      Content,
    };
  })
);

// Sort by section number
const sortedConventions = conventionsContent.sort(
  (a, b) => Number(a.data.section) - Number(b.data.section)
);

---

<Layout title="Triforce Quartet" main="services">
  <section id="hero">
    <figure>
      <img src="/img/conventions.jpg" alt="Triforce Quartet performing live at PAX West in Seattle" />
    </figure>
    <h2>
      <span>Bringing Legendary <br />Video Game <br />Music to Life</span>
    </h2>
    <h4>The Ultimate String Quartet Experience for Conventions</h4>
    <p>Triforce Quartet is a string quartet built around video game music: classically trained players performing the soundtracks your attendees grew up on. Our repertoire runs from Zelda, Final Fantasy, and Super Mario to Hollow Knight, Halo, and Undertale, and we play them live with the energy of a main-stage set and the precision of trained musicians.</p>
    <button class="cta" data-contact-dialog>Check Availability</button>
  </section>
	<!-- <Welcome /> -->
    {sortedConventions.map((convention) => (
        <Section title={convention.data.title}>
            <convention.Content />
        </Section>
    ))}

</Layout>
