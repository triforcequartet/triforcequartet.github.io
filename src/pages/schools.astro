---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
const schools = await getCollection('schools');
const schoolsContent = await Promise.all(
  schools.map(async (school) => {
    const { Content } = await school.render();
    return {
      ...school,
      Content,
    };
  })
);

// Sort by section number
const sortedSchools = schoolsContent.sort(
  (a, b) => Number(a.data.section) - Number(b.data.section)
);

---

<Layout title="Triforce Quartet" main="services">
  <section id="hero">
    <figure>
      <img src="/img/schools.jpg" alt="Triforce Quartet performing at MAGFest" />
    </figure>
    <h2>
      <span>Inspiring the <br />Next Generation <br />Through Music</span>
    </h2>
    <h4>Live Music Programs for Schools, Camps, and Youth Events</h4>
    <p>We bring live music into schools, camps, and youth events, and we do it with music students actually recognize. Triforce Quartet pairs classical experience with music from video games, so the performance holds a room of young people and still teaches them something about how music works.</p>
    <p>Some of our members are professional music instructors, so we know how to hold a student audience and keep it fun. We lead with humor and a lack of pretension, and the goal is simple: make string instruments feel genuinely fun to musicians-in-training, gamers, and kids who are just curious.</p>
    <p>We work with educators and program directors to build the format around your goals, whether that's a one-time concert, an interactive workshop, or a masterclass. Tell us the age group and what you want students to take away, and we'll shape it to fit.</p>
    <button class="cta" data-contact-dialog>Check Availability</button>
  </section>
	<!-- <Welcome /> -->
    {sortedSchools.map((school) => (
        <Section title={school.data.title}>
            <school.Content />
        </Section>
    ))}

</Layout>
