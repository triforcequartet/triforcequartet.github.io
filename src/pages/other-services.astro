---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
const otherservices = await getCollection('otherservices');
const otherservicesContent = await Promise.all(
  otherservices.map(async (otherservice) => {
    const { Content } = await otherservice.render();
    return {
      ...otherservice,
      Content,
    };
  })
);

// Sort by section number
const sortedotherservices = otherservicesContent.sort(
  (a, b) => Number(a.data.section) - Number(b.data.section)
);

---

<Layout title="Triforce Quartet" main="services">
  <section id="hero">
    <figure>
      <img src="/img/other-events.jpg" alt="Triforce Quartet main group picture" class="position-top" />
    </figure>
       <h2>
      <span>Custom <br />Performances for <br />Any Occasion</span>
    </h2>
    <h4>Have an event in mind that's not on our list? Let's make it happen.</h4>
    <p>Not every performance fits neatly into a category. Maybe you're planning a private surprise for someone, hosting a themed dinner, producing a live-streamed event, or curating music for an art opening. Whatever you have in mind, we'll build a performance around it.</p>
    <p>Our repertoire spans many genres, and we've played everywhere from concert halls to dive bars. Tell us the occasion and the feel you're after, and we'll shape something to fit!</p>
    <button class="cta" data-contact-dialog>Check Availability</button>
  </section>
	<!-- <Welcome /> -->
    {sortedotherservices.map((otherservice) => (
        <Section title={otherservice.data.title}>
            <otherservice.Content />
        </Section>
    ))}

</Layout>
