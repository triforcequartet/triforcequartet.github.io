---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
const conventions = await getCollection('conventions');
const conventionsContent = await Promise.all(
  conventions.map(async (convention) => {
    const { Content } = await convention.render();
    return {
      ...convention,
      Content,
    };
  })
);

// Sort by section number
const sortedConventions = conventionsContent.sort(
  (a, b) => Number(a.data.section) - Number(b.data.section)
);

---

<Layout title="Triforce Quartet" main="services">
  <section id="hero">
    <figure>
      <img src="/img/conventions.jpg" alt="Triforce Quartet performing live at PAX West in Seattle" />
    </figure>
    <h2>
      <span>Bringing<br />Video Game<br />Music to Life</span>
    </h2>
    <h4>A Memorable Experience for Conventions</h4>
    <p>Triforce Quartet is a string quartet built around video game music. We're gamers ourselves, so the music we play has a real personal connection for us. Our repertoire runs from Zelda, Final Fantasy, and Super Mario to Hollow Knight, Pokemon, and Undertale, all performed live, with no backing tracks and no AI.</p>
    <button class="cta" data-contact-dialog>Check Availability</button>
  </section>
	<!-- <Welcome /> -->
    {sortedConventions.map((convention) => (
        <Section title={convention.data.title}>
            <convention.Content />
        </Section>
    ))}

</Layout>
